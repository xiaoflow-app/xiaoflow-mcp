{
  "name": "xiaoflow-mcp-server",
  "version": "1.4.0",
  "description": "Official MCP server for XiaoFlow AI SEO and keyword intelligence tools",
  "main": "build/node.js",
  "type": "module",
  "bin": {
    "xiaoflow-mcp-server": "build/node.js",
    "xiaoflow-mcp": "build/node.js"
  },
  "files": [
    "build",
    "README.md",
    "smithery.yaml"
  ],
  "scripts": {
    "build": "tsc && cp build/node.js build/index.js",
    "start": "node build/node.js",
    "dev": "tsc --watch",
    "deploy": "wrangler deploy",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "mcp-server",
    "xiaoflow",
    "seo",
    "keyword-research",
    "ai-tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaoq-in/xiaoflow-mcp.git"
  },
  "homepage": "https://www.xiaoflow.com/mcp",
  "bugs": {
    "url": "https://github.com/xiaoq-in/xiaoflow-mcp/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "author": "XiaoFlow Team <contact@xiaoflow.com>",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.1",
    "axios": "^1.6.0",
    "dotenv": "^16.3.1",
    "hono": "^4.6.14",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.8.0",
    "typescript": "^5.2.2",
    "wrangler": "^4.113.0"
  }
}
